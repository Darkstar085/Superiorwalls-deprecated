<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="NewApi">

    <style name="Superiorwalls" />

    <style name="Superiorwalls.SplashScreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/accent</item>

        <item name="colorPrimaryVariant">@color/primaryDark</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/onAccent</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/onSurface</item>

        <item name="colorBackgroundFloating">@color/background</item>
        <item name="colorOnBackground">@color/onBackground</item>

        <item name="android:textColorPrimary">?colorOnSurface</item>

        <item name="android:navigationBarColor">?colorSurface</item>
        <item name="android:navigationBarDividerColor">@color/transparent</item>
        <item name="android:colorEdgeEffect">?colorSecondary</item>

        <item name="customFontBold">@font/manrope_bold_fam</item>
        <item name="customFontNormal">@font/manrope_normal_fam</item>

        <item name="snackbarBackgroundColor">@color/snackbarBackgroundColor</item>
        <item name="snackbarTextColor">@color/snackbarTextColor</item>
        <item name="snackbarButtonColor">@color/snackbarButtonColor</item>

        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">false</item>

        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:forceDarkAllowed">true</item>
        <item name="popupMenuBackground">@drawable/menu_background</item>
    </style>

    <style name="Superiorwalls.SplashScreen.Amoled" parent="Superiorwalls.SplashScreen" />

    <style name="Superiorwalls.Default" parent="Superiorwalls.SplashScreen">
        <item name="android:windowBackground">@color/background</item>

        <item name="textAppearanceHeadline3">@style/TextAppearance.Superiorwalls.Headline3</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Superiorwalls.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.Superiorwalls.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Superiorwalls.Headline6</item>

        <item name="textAppearanceSubtitle1">@style/TextAppearance.Superiorwalls.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Superiorwalls.Subtitle2</item>

        <item name="textAppearanceButton">@style/TextAppearance.Superiorwalls.Button</item>

        <item name="textAppearanceBody1">@style/TextAppearance.Superiorwalls.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Superiorwalls.Body2</item>

        <item name="textAppearanceCaption">@style/TextAppearance.Superiorwalls.Caption</item>
        <item name="textAppearanceOverline">@style/TextAppearance.Superiorwalls.Overline</item>

        <item name="android:dialogTheme">@style/Superiorwalls.Dialogs</item>
        <item name="android:alertDialogTheme">@style/Superiorwalls.Dialogs</item>
        <item name="materialAlertDialogTheme">@style/Superiorwalls.Dialogs</item>

        <item name="materialCardViewStyle">@style/Widget.Superiorwalls.MaterialCardView</item>
        <item name="bottomSheetDialogTheme">@style/Superiorwalls.BottomSheetDialog</item>
        <item name="navigationViewStyle">@style/Widget.Superiorwalls.NavigationView</item>
        <item name="toolbarStyle">@style/Widget.MaterialComponents.Toolbar.PrimarySurface</item>
        <item name="bottomNavigationStyle">@style/Widget.Superiorwalls.BottomNavigationView</item>

        <item name="shapeAppearanceSmallComponent">
            @style/ShapeAppearance.Superiorwalls.SmallComponent
        </item>
        <item name="shapeAppearanceMediumComponent">
            @style/ShapeAppearance.Superiorwalls.MediumComponent
        </item>
        <item name="shapeAppearanceLargeComponent">
            @style/ShapeAppearance.Superiorwalls.LargeComponent
        </item>
    </style>

    <style name="Superiorwalls.Default.Amoled" parent="Superiorwalls.Default" />

    <style name="Widget.Superiorwalls.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@drawable/bottom_navigation_states</item>
        <item name="itemTextColor">@drawable/bottom_navigation_states</item>
    </style>

    <style name="Widget.Superiorwalls.ViewerBottomNavigationView" parent="Widget.Superiorwalls.BottomNavigationView">
        <item name="itemRippleColor">@color/viewer_item_ripple</item>
        <item name="itemIconTint">@drawable/bottom_actions_states</item>
        <item name="itemTextColor">@drawable/bottom_actions_states</item>
    </style>

    <!-- Bottom Sheet Dialogs -->
    <style name="Superiorwalls.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Superiorwalls.BottomSheet.Modal.Animation</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="bottomSheetStyle">@style/Superiorwalls.BottomSheet.Modal</item>
        <item name="android:navigationBarColor">?colorSurface</item>
        <item name="android:navigationBarDividerColor">@color/transparent</item>
    </style>

    <style name="Superiorwalls.BottomSheet.Modal" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">?shapeAppearanceLargeComponent</item>
    </style>

    <style name="Superiorwalls.BottomSheet.Modal.Animation" parent="Animation.AppCompat.Dialog">
        <item name="android:windowEnterAnimation">@anim/bottom_sheet_slide_in</item>
        <item name="android:windowExitAnimation">@anim/bottom_sheet_slide_out</item>
    </style>

    <!--Navigation Drawer-->
    <style name="Widget.Superiorwalls.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="itemTextAppearance">?textAppearanceBody2</item>
    </style>

    <style name="Widget.Superiorwalls.TextButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/text_btn_bg_color</item>
        <item name="rippleColor">@color/text_btn_ripple_color</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:textColor">?colorSecondary</item>
    </style>

    <style name="Widget.Superiorwalls.ColoredButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colored_btn_bg_color</item>
        <item name="rippleColor">@color/colored_btn_ripple_color</item>
        <item name="android:textColor">?colorOnSecondary</item>
    </style>

    <style name="Widget.Superiorwalls.SurfaceButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/surface_btn_bg_color</item>
        <item name="rippleColor">@color/surface_btn_ripple_color</item>
        <item name="android:textColor">?colorOnSurface</item>
    </style>

    <style name="MyApp.Default" parent="Superiorwalls.Default" />

    <style name="MyApp.Default.Amoled" parent="Superiorwalls.Default.Amoled" />

    <style name="MyApp.Default.MaterialYou" parent="Superiorwalls.Default.MaterialYou" />

    <style name="MyApp.Default.Amoled.MaterialYou" parent="Superiorwalls.Default.Amoled.MaterialYou" />

</resources>
